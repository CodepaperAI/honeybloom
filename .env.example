# Public site URL used by SEO metadata, sitemap, robots.txt, and structured data.
# Must match the live origin exactly, including the www subdomain — the apex
# 308-redirects to www, so canonicalising to the apex points at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.honeybloombeauty.com

# Transactional email delivery (contact form).
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend. Falls back to Resend's
# shared testing address, which only delivers to the account owner.
CONTACT_FROM_EMAIL=

# --- Cloudflare Turnstile (bot protection) ----------------------------------
# Required in production. The endpoint FAILS CLOSED without TURNSTILE_SECRET_KEY:
# a deploy missing it rejects every submission rather than reopening the contact
# endpoint as an unauthenticated email relay.
#
# For local development and previews, Cloudflare publishes test keys that always
# pass — these are public values from Cloudflare's docs, not secrets:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The always-fails site key is 2x00000000000000000000AB.
#
# Never let the test SITE key reach production — every widget would solve
# instantly and the form would look healthy while being completely unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uplift AI blog API token (server-side, used by the blog pages).
UPLIFT_API_TOKEN=
