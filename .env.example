# Public site URL used by SEO metadata, sitemap, robots.txt, and structured data.
# Must match the live origin exactly, including the www subdomain — the apex
# 308-redirects to www, so canonicalising to the apex points at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.honeybloombeauty.com

# Transactional email delivery (contact form).
RESEND_API_KEY=

# Uplift AI blog API token (server-side, used by the blog pages).
UPLIFT_API_TOKEN=
